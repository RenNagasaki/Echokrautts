# Bind-mount targets created by docker-compose when deploying from a checkout.
# (The install-state ignores for the bare-metal install live in wrapper/.gitignore.)
/models/
/samples/
.env

# Machine-local Claude Code state (worklog, verify script).
.claude/

# Python bytecode from tooling run at the repo root (e.g. the release
# builder imported by its tests). The wrapper has its own .gitignore.
__pycache__/
